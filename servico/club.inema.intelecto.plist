<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS (launchd): troque SEU_USUARIO e copie para ~/Library/LaunchAgents/
     launchctl load ~/Library/LaunchAgents/club.inema.intelecto.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>club.inema.intelecto</string>
  <key>WorkingDirectory</key><string>/Users/SEU_USUARIO/intelecto-v2</string>
  <key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>-m</string><string>intelecto</string><string>telegram</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/intelecto.err</string>
</dict></plist>
